<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.barf.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>برف</name>
  <description>برنامه حسابداری برف</description>
  <content src="index.html" />
  <access origin="*" />
  <allow-navigation href="*" />
